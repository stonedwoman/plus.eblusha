{
  // Бот собирается отдельно от backend (свой package.json и node_modules),
  // но строгость та же, что в корневом tsconfig: интеграционный тест в
  // test/secret-env гоняет эти же исходники через ts-node с корневыми настройками.
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/unit/**/*.ts"],
  "exclude": ["node_modules", "dist", "data"]
}
