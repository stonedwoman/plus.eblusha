<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development: dev-сборки из Xcode получают sandbox-токены (серверу тогда нужен
	     APNS_ENV=sandbox — см. docs/apns-setup.md). Для TestFlight/App Store Xcode при
	     подписи дистрибутива сам заменяет значение на production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Общий домен с Notification Service Extension: «Без звука» и журнал значка
	     (Core/Mute/MuteSharedState.swift). Ключи Keychain это не трогает: без
	     keychain-access-groups группа доступа по умолчанию остаётся прежней. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.eblusha.plus</string>
	</array>
</dict>
</plist>
