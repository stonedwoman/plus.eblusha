## Server env example (do NOT commit real secrets)
#
# Docker (docker-compose.full.yml): задайте для postgres и backend
# POSTGRES_PASSWORD=your_secure_password
#
# Core
NODE_ENV=development
PORT=4000
# CORS: один origin или несколько через запятую (http://stoned.local,https://eblusha.org)
CLIENT_URL=http://localhost:5173

# Cookie Secure: 0/false = разрешить cookies по HTTP (для stoned.local и т.п.)
# COOKIE_SECURE=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eblusha
REDIS_URL=redis://localhost:6379
# Protect /api/status/metrics (Authorization: Bearer <token>)
METRICS_TOKEN=replace_with_long_random_token

# Optional bearer token for /api/admin/*. The default deployment binds the
# admin nginx listener AND the backend port to host loopback only (see
# deploy/docker-compose.full.yml + deploy/nginx-docker.conf), so reaching the
# admin API already requires SSH access to the host. In that setup the token
# is redundant and you can leave ADMIN_TOKEN empty for password-less access.
# Set it to a >=16 char random string only if you publish admin behind a
# reverse proxy / VPN where additional auth is desired.
# Example: openssl rand -hex 32
ADMIN_TOKEN=

# Storage: "local" | "s3" (default). For local, no S3 vars needed.
STORAGE_BACKEND=local
# For STORAGE_BACKEND=local: base directory for attachments (must exist or be writable)
LOCAL_STORAGE_PATH=/var/lib/eblusha/storage
# Required for uploads: STORAGE_ENC_KEY (base64 or hex, 32 bytes), STORAGE_PREFIX=uploads
# STORAGE_ENC_V2=true — потоковое шифрование EBP2, рекомендуется для файлов 700MB+

# Dev-only escape hatch (default false). Never enable in prod.
ALLOW_DEVICE_QUERY=false

# Auth
JWT_SECRET=replace_with_32+_chars_minimum________________
JWT_REFRESH_SECRET=replace_with_32+_chars_minimum________________
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=180d

# LiveKit: либо LIVEKIT_URL (полный ws(s)://host), либо LIVEKIT_PATH (путь, без домена)
# LIVEKIT_PATH=/api/voice  # URL строится от хоста запроса
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional external TURN relay (recommended for restrictive/mobile networks or RU clients).
# LiveKit will advertise these ICE servers to clients automatically when set.
# Set LIVEKIT_NODE_IP on hosts where STUN-based external IP discovery is unreliable.
# LIVEKIT_NODE_IP=203.0.113.10
# LIVEKIT_TURN_HOST=ru.eblusha.org
# LIVEKIT_TURN_SECRET=replace_with_separate_shared_turn_secret
# LIVEKIT_TURN_UDP_PORT=3478
# LIVEKIT_TURN_TCP_PORT=3478
# LIVEKIT_TURN_TLS_PORT=5349  # optional, requires TLS certs on the TURN host
# LIVEKIT_TURN_TTL=14400

# Feature flags
# Enable LiveKit E2EE for 1:1 calls (backend gate for key endpoint + key generation on call start)
E2EE_1TO1=false

# Frontend (Vite) feature flags (must be prefixed with VITE_)
VITE_E2EE_1TO1=false

# Queue / workers
# Uses REDIS_URL. Run at least one API instance with workers enabled (default in src/server.ts).
#
# YouTube Data API v3 (recommended fallback for stable YouTube previews)
# Create key in Google Cloud Console, restrict it for server use, and set it here.
YOUTUBE_API_KEY=


# ── Eblusha Cloud (приватное файловое хранилище, src/cloud) ──────────────────
# Выключается одним флагом, мессенджер при этом работает как раньше.
CLOUD_ENABLED=1
# Корень физического хранилища: objects/ derived/ staging/ tmp/
# Создать заранее: см. docs/eblusha-cloud.md (права нужны разные для подкаталогов)
CLOUD_STORAGE_ROOT=/var/lib/eblusha/cloud
# Логическая квота оригиналов и обязательный свободный резерв на ФС.
# Заполнять диск под завязку нельзя: без резерва ляжет и Postgres.
# Принимаются суффиксы K/M/G/T.
CLOUD_STORAGE_MAX_BYTES=520G
CLOUD_STORAGE_MIN_FREE_BYTES=100G
# Мягкий потолок кэша превью/постеров/web-видео. Производные восстановимы,
# поэтому при нехватке места maintenance их подрезает.
CLOUD_DERIVED_CACHE_MAX_BYTES=60G
CLOUD_MAX_FILE_BYTES=64G
CLOUD_TRASH_RETENTION_DAYS=30
# Сколько живёт незавершённая загрузка (докачка возможна всё это время)
CLOUD_UPLOAD_TTL_HOURS=336
CLOUD_SESSION_TTL_DAYS=30
# Отдача файлов через nginx X-Accel-Redirect (deploy/nginx-cloud.inc).
# 0 — стримить из Node (dev / доступ мимо nginx).
CLOUD_XACCEL=1
# Логины Еблуши, которым доступен /cloud/admin/storage (через запятую).
# Пусто = админский экран недоступен никому.
CLOUD_ADMIN_USERNAMES=
CLOUD_IMAGE_CONCURRENCY=2
# 1 — сознательно: два параллельных x264 на 4 ядрах кладут звонки и чат
CLOUD_VIDEO_CONCURRENCY=1
# Базовый URL для генерации share/join-ссылок (иначе берётся из запроса)
CLOUD_PUBLIC_BASE_URL=https://cloud.eblusha.org
# Origin мессенджера: туда Cloud уводит браузер за одноразовым кодом, когда живёт
# на отдельном поддомене (там лежит сессия Еблуши, в другом origin её нет).
CLOUD_MESSENGER_ORIGIN=https://eblusha.org
# Префикс UI-путей. Пусто = домен отдан Cloud целиком (eblusha.cloud/space/...),
# "/cloud" = Cloud живёт рядом с мессенджером (eblusha.org/cloud/space/...).
# Влияет на генерацию share- и join-ссылок.
CLOUD_PUBLIC_PATH_PREFIX=
# Строгий allowlist origin'ов, куда разрешено возвращать код авторизации.
# ПУСТО = Cloud и мессенджер на одном origin, редирект-flow выключен.
# Открытый редирект здесь означал бы выдачу кода постороннему сайту.
CLOUD_ALLOWED_REDIRECT_ORIGINS=https://cloud.eblusha.org
# Тайлы карты EXIF-GPS: провайдер настраивается
CLOUD_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CLOUD_MAP_ATTRIBUTION=© OpenStreetMap
