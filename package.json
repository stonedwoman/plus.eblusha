{
  "name": "eblusha-plus",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development prisma generate && nodemon --watch src --exec \"ts-node\" src/server.ts",
    "dev:worker": "cross-env NODE_ENV=development prisma generate && nodemon --watch src --exec \"ts-node\" src/worker.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "test:link-detect": "ts-node test/link-detect.test.ts",
    "test:youtube-link-preview": "ts-node test/youtube-link-preview.test.ts",
    "test:ssrf": "ts-node test/ssrf-guard.test.ts",
    "test:link-preview-ssrf": "ts-node test/link-preview-ssrf.test.ts",
    "test:secret-inbox-ttl": "ts-node test/secret-inbox-ttl.test.ts",
    "test:comms": "ts-node test/comms.integration.test.ts",
    "test:secret-threads": "ts-node test/secret-threads.integration.test.ts",
    "test:presence-multi-instance": "ts-node test/presence-multi-instance.integration.test.ts",
    "test:storage-enc-key": "ts-node test/storage-enc-key.smoke.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "docker:db": "docker compose up -d postgres",
    "deploy": "PATH=/usr/bin:$PATH bash -c 'cd frontend && npm ci && npm run build' && docker compose -f deploy/docker-compose.full.yml --env-file .env build --no-cache backend worker maintenance && docker compose -f deploy/docker-compose.full.yml --env-file .env pull postgres redis nginx livekit && docker compose -f deploy/docker-compose.full.yml --env-file .env up -d",
    "docker:full": "docker compose -f deploy/docker-compose.full.yml up -d",
    "docker:full:down": "docker compose -f deploy/docker-compose.full.yml down",
    "smoke:local": "ts-node test/local-smoke.ts",
    "smoke:test": "ts-node test/platform-smoke.ts",
    "smoke": "ts-node test/run-smoke.ts",
    "gc:device-prekeys": "ts-node src/scripts/gcDevicePrekeys.ts",
    "gc:secret-attachments": "ts-node src/scripts/gcSecretAttachments.ts",
    "gc:upload-sessions": "ts-node src/scripts/gcUploadSessions.ts",
    "migrate:uploads": "ts-node src/scripts/migrateUploads.ts",
    "encrypt:s3": "ts-node src/scripts/encryptS3Objects.ts",
    "migrate:eblusha-keys": "ts-node src/scripts/migrateKeysToEblusha.ts",
    "migrate:s3-to-local": "ts-node src/scripts/migrateS3ToLocal.ts",
    "gc:unused-storage": "ts-node src/scripts/gcUnusedStorageFiles.ts",
    "unify-storage": "ts-node src/scripts/unifyStorage.ts",
    "audit:users": "ts-node src/scripts/listUsersAudit.ts",
    "audit:users:table": "ts-node src/scripts/listUsersAudit.ts --table",
    "cleanup:integration-test-users": "ts-node src/scripts/deleteIntegrationTestUsers.ts",
    "start:cloud-worker": "node dist/cloudWorker.js",
    "dev:cloud-worker": "cross-env NODE_ENV=development prisma generate && nodemon --watch src --exec \"ts-node\" src/cloudWorker.ts",
    "cloud:maintenance": "node dist/scripts/cloudMaintenance.js",
    "test:cloud": "ts-node test/cloud.smoke.test.ts",
    "cloud:dedupe": "ts-node src/scripts/cloudDedupeSpaceFiles.ts",
    "cloud:wipe": "ts-node src/scripts/cloudWipe.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Eblusha LiveKit messenger platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "archiver": "^7.0.1",
    "aws-cli-js": "^2.2.3",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.19.0",
    "livekit-server-sdk": "^2.15.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^23.11.1",
    "redis": "^5.12.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "websockets": "^0.2.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^25.9.1",
    "@types/socket.io": "^3.0.2",
    "@types/socket.io-client": "^3.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
