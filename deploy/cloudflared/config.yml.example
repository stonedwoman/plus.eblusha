# Скопируйте в /etc/cloudflared/config.yml (или рядом с credentials) и подставьте:
#   tunnel: <UUID из cloudflared tunnel create>
#   credentials-file: путь к <UUID>.json
#
# Локальный origin — тот же nginx, что и для eblusha.org в проде (порт 80 или 443 см. README).

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

# Сжатие и таймауты для WebSocket / длинных загрузок
# (при необходимости раскомментируйте и подстройте)
# originRequest:
#   connectTimeout: 30s
#   tcpKeepAlive: 30s
#   noHappyEyeballs: true

ingress:
  # Основной сайт и витрина Valheim (/v, /v/valheim-join-code.json и т.д.)
  - hostname: eblusha.org
    service: http://127.0.0.1:80
  - hostname: www.eblusha.org
    service: http://127.0.0.1:80

  # Если LiveKit/голос открыты на отдельном поддомене (LIVEKIT_URL=wss://voice.eblusha.org)
  - hostname: voice.eblusha.org
    service: http://127.0.0.1:80

  # При необходимости добавьте сюда любые дополнительные hostname’ы того же nginx.

  - service: http_status:404
