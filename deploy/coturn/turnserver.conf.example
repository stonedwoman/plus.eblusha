# Copy to turnserver.conf on the RU server and replace the shared secret.
# This config enables TURN over UDP/TCP on 3478 and can optionally enable TURN/TLS on 5349.

realm=ru.eblusha.org
server-name=ru.eblusha.org

listening-ip=0.0.0.0
listening-port=3478

# Relay ports used for forwarded media. Open this TCP/UDP range on the RU server firewall.
min-port=49160
max-port=49200

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_SECRET
stale-nonce

no-cli
no-multicast-peers

# Optional TLS. Uncomment only after mounting valid certs in ./certs.
# tls-listening-port=5349
# cert=/etc/coturn/certs/fullchain.pem
# pkey=/etc/coturn/certs/privkey.pem

# If the RU server is itself behind NAT, set its public IP here.
# external-ip=203.0.113.10

log-file=stdout
simple-log
