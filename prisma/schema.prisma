// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                                     @id @default(cuid())
  createdAt                     DateTime                                   @default(now())
  updatedAt                     DateTime                                   @updatedAt
  username                      String                                     @unique
  eblid                         String?                                    @unique
  email                         String?                                    @unique
  phone                         String?                                    @unique
  displayName                   String?
  bio                           String?
  avatarUrl                     String?
  avatarHistory                 String[]                                   @default([])
  passwordHash                  String
  status                        UserStatus                                 @default(OFFLINE)
  lastSeenAt                    DateTime?
  /// Set by admin to prevent login + socket connections. Reversible.
  bannedAt                      DateTime?
  bannedReason                  String?
  /// Set by admin "delete account" — anonymized + permanently disabled. Not reversible.
  deletedAt                     DateTime?
  contactsRequested             Contact[]                                  @relation("ContactRequester")
  contactsReceived              Contact[]                                  @relation("ContactAddressee")
  conversations                 ConversationParticipant[]
  conversationsCreated          Conversation[]                             @relation("ConversationCreator")
  messages                      Message[]
  messageReactions              MessageReaction[]
  messageReceipts               MessageReceipt[]
  tokens                        RefreshToken[]
  callSessions                  CallSession[]                              @relation("CallSessionInitiator")
  callParticipations            CallParticipant[]
  devices                       UserDevice[]
  registrationInviteCode        RegistrationInviteCode?
  availabilityIntervals         ConversationAvailabilityInterval[]
  availabilityProposalsCreated  ConversationAvailabilityProposal[]         @relation("AvailabilityProposalCreator")
  availabilityProposalReactions ConversationAvailabilityProposalReaction[]
  // Eblusha Cloud (см. блок моделей Cloud* в конце файла). Обратные связи нужны
  // Prisma для FK; таблицу users они не меняют.
  cloudSpacesOwned              CloudSpace[]                               @relation("CloudSpaceOwner")
  cloudMemberships              CloudSpaceMember[]
  cloudFiles                    CloudFile[]                                @relation("CloudFileUploader")
  cloudUploads                  CloudUploadSession[]
  cloudComments                 CloudComment[]                             @relation("CloudCommentAuthor")
  cloudReactions                CloudReaction[]
  cloudActivity                 CloudActivityEvent[]                       @relation("CloudActivityActor")
  cloudShares                   CloudShareLink[]                           @relation("CloudShareCreator")
  cloudInvites                  CloudInvite[]                              @relation("CloudInviteCreator")
}

model Contact {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  requesterId String
  addresseeId String
  status      ContactStatus @default(PENDING)
  requester   User          @relation("ContactRequester", fields: [requesterId], references: [id])
  addressee   User          @relation("ContactAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model RegistrationInviteCode {
  userId       String   @id
  code         String   @unique
  minuteBucket BigInt
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                      String                             @id @default(cuid())
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  /// Conversation storage/encryption mode
  type                    ConversationType                   @default(CLOUD)
  title                   String?
  avatarUrl               String?
  isGroup                 Boolean                            @default(false)
  /// Marks a conversation as secret (ephemeral 1:1 chats, end-to-end friendly)
  isSecret                Boolean                            @default(false)
  /// Wrapped per-conversation DEK (base64) for server-side encryption in NON-secret chats
  nonSecretDekWrapped     String?                            @db.Text
  /// Optional message TTL in seconds for secret conversations; null means use default
  secretTtlSeconds        Int?
  secretStatus            SecretConversationStatus           @default(ACTIVE)
  secretInitiatorDeviceId String?
  secretPeerDeviceId      String?
  lastMessageAt           DateTime?
  createdById             String?
  createdBy               User?                              @relation("ConversationCreator", fields: [createdById], references: [id])
  participants            ConversationParticipant[]
  messages                Message[]
  callSessions            CallSession[]
  availabilityIntervals   ConversationAvailabilityInterval[]
  availabilityProposals   ConversationAvailabilityProposal[]
}

enum ConversationType {
  CLOUD
  SECRET
}

model ConversationParticipant {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  mutedUntil     DateTime?
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model ConversationAvailabilityInterval {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversationId String
  userId         String
  startUtc       DateTime
  endUtc         DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId, startUtc, endUtc])
  @@index([conversationId, userId])
  @@index([conversationId, startUtc])
}

enum AvailabilityProposalReactionValue {
  YES
  MAYBE
  NO
}

model ConversationAvailabilityProposal {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  conversationId String
  createdById    String
  note           String?
  /// Max end time of all ranges for filtering expired proposals
  maxEndUtc      DateTime
  deletedAt      DateTime?

  conversation Conversation                               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User                                       @relation("AvailabilityProposalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  intervals    ConversationAvailabilityProposalInterval[]
  reactions    ConversationAvailabilityProposalReaction[]

  @@index([conversationId, maxEndUtc])
  @@index([conversationId, createdAt])
  @@index([createdById, createdAt])
}

model ConversationAvailabilityProposalInterval {
  id         String                           @id @default(cuid())
  proposalId String
  startUtc   DateTime
  endUtc     DateTime
  proposal   ConversationAvailabilityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, startUtc, endUtc])
  @@index([proposalId, startUtc])
}

model ConversationAvailabilityProposalReaction {
  id         String                            @id @default(cuid())
  proposalId String
  userId     String
  value      AvailabilityProposalReactionValue
  createdAt  DateTime                          @default(now())
  updatedAt  DateTime                          @updatedAt

  proposal ConversationAvailabilityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User                             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([userId, createdAt])
}

model Message {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  conversationId String
  senderId       String
  type           MessageType         @default(TEXT)
  content        String?
  /// 0 = plaintext, 1 = encrypted (non-secret chats server-side encryption)
  contentEncV    Int                 @default(0)
  metadata       Json?
  replyToId      String?
  replyTo        Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]           @relation("MessageReplies")
  deletedAt      DateTime?
  /// Optional expiration time (for secret/ephemeral messages)
  expiresAt      DateTime?
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  sender         User                @relation(fields: [senderId], references: [id])
  attachments    MessageAttachment[]
  reactions      MessageReaction[]
  receipts       MessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([conversationId, contentEncV])
  @@index([replyToId])
}

model MessageAttachment {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  messageId String
  url       String
  type      AttachmentType
  size      Int?
  metadata  Json?
  message   Message        @relation(fields: [messageId], references: [id])

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  messageId String
  userId    String
  emoji     String
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model MessageReceipt {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  messageId String
  userId    String
  status    ReceiptStatus @default(DELIVERED)
  message   Message       @relation(fields: [messageId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId, status])
}

model RefreshToken {
  id               String    @id @default(cuid())
  token            String    @unique
  userId           String
  sessionId        String?
  client           String?
  deviceId         String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  replacedByToken  String?   @unique
  revocationReason String?
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([userId, sessionId])
}

model CallSession {
  id             String            @id @default(cuid())
  startedAt      DateTime          @default(now())
  endedAt        DateTime?
  conversationId String
  initiatorId    String
  roomName       String
  type           CallType          @default(VOICE)
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  initiator      User              @relation("CallSessionInitiator", fields: [initiatorId], references: [id])
  participants   CallParticipant[]

  @@index([conversationId])
}

model CallParticipant {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  session   CallSession @relation(fields: [sessionId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
  BACKGROUND
  IN_CALL
}

enum ContactStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ConversationRole {
  MEMBER
  ADMIN
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
  CALL
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum ReceiptStatus {
  DELIVERED
  READ
  SEEN
}

enum CallType {
  VOICE
  VIDEO
}

model UserDevice {
  id                    String         @id
  userId                String
  name                  String
  platform              String?
  publicKey             String
  identityPublicKey     String?
  signedPreKeyId        String?
  signedPreKeyPublic    String?
  signedPreKeySignature String?
  signedPreKeyExpiresAt DateTime?
  keyVersion            Int            @default(1)
  keyAlg                String         @default("x25519+ed25519")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastSeenAt            DateTime?
  revokedAt             DateTime?
  lastIp                String?
  lastCountry           String?
  lastCity              String?
  // Токен push-уведомлений (FCM для Android, APNs-alert для iOS). Живёт отдельно от ключей
  // шифрования: система выдаёт новый после переустановки или очистки данных приложения.
  pushToken             String?
  pushProvider          String?
  pushUpdatedAt         DateTime?
  // Отдельный слот под VoIP-токен iOS: PushKit выдаёт СВОЙ токен, не тот, что для обычных
  // уведомлений, и оба нужны одновременно — alert будит уведомление о сообщении, а VoIP
  // поднимает убитое приложение под звонок (без него CallKit не показать вовремя).
  // У Android слот пустует: там один FCM-токен на всё.
  pushVoipToken         String?
  pushVoipUpdatedAt     DateTime?
  user                  User           @relation(fields: [userId], references: [id])
  prekeys               DevicePrekey[]

  @@index([userId])
  @@index([pushToken])
  @@index([pushVoipToken])
}

model DevicePrekey {
  id                  String     @id @default(cuid())
  deviceId            String
  keyId               String
  publicKey           String
  oneTimePreKeyId     String?
  oneTimePreKeyPublic String?
  version             Int        @default(1)
  alg                 String     @default("x25519")
  createdAt           DateTime   @default(now())
  consumedAt          DateTime?
  device              UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, consumedAt])
}

enum SecretConversationStatus {
  ACTIVE
  PENDING
  CANCELLED
}

/// Durable ciphertext storage for SECRET threads + per-device delivery.
/// Source of truth is Postgres; Redis is only an inbox/cache accelerator.
model SecretMessage {
  msgId          String   @id @default(uuid()) @map("msgId")
  threadId       String?  @map("threadId")
  senderUserId   String   @map("senderUserId")
  senderDeviceId String?  @map("senderDeviceId")
  createdAt      DateTime @default(now()) @map("createdAt")
  headerJson     Json     @map("headerJson")
  ciphertextBlob Bytes    @map("ciphertextBlob")
  contentType    String   @map("contentType")
  schemaVersion  Int      @default(1) @map("schemaVersion")

  deliveries SecretDelivery[]

  @@index([threadId, createdAt])
  @@index([senderUserId, createdAt])
  @@map("messages_secret")
}

enum SecretDeliveryStatus {
  PENDING
  DELIVERED
  READ
}

model SecretDelivery {
  msgId            String               @map("msgId")
  receiverDeviceId String               @map("receiverDeviceId")
  status           SecretDeliveryStatus @default(PENDING) @map("status")
  deliveredAt      DateTime?            @map("deliveredAt")
  readAt           DateTime?            @map("readAt")

  message SecretMessage @relation(fields: [msgId], references: [msgId], onDelete: Cascade)

  @@id([msgId, receiverDeviceId])
  @@index([receiverDeviceId, status])
  @@map("deliveries_secret")
}

/// Metadata-only refs for ciphertext attachments in SECRET threads.
/// No plaintext keys/content are stored server-side.
model SecretAttachmentRef {
  id          String    @id @default(cuid())
  threadId    String    @map("threadId")
  objectKey   String    @map("objectKey")
  ownerUserId String    @map("ownerUserId")
  createdAt   DateTime  @default(now()) @map("createdAt")
  expiresAt   DateTime? @map("expiresAt")
  deletedAt   DateTime? @map("deletedAt")

  @@unique([threadId, objectKey])
  @@index([threadId, deletedAt])
  @@index([ownerUserId, deletedAt])
  @@index([expiresAt, deletedAt])
  @@map("secret_attachment_refs")
}

/// One-time pairing token for linking a new device to an existing trusted device.
model DevicePairing {
  token              String    @id
  userId             String
  newDeviceId        String
  code               String
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByDeviceId String?

  @@index([userId, expiresAt])
  @@index([newDeviceId, expiresAt])
  @@map("device_pairings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Eblusha Cloud — приватное файловое хранилище поверх той же БД/Redis/Socket.IO.
// Identity здесь НЕ дублируется: везде ссылка на User.id Еблуши.
// ─────────────────────────────────────────────────────────────────────────────

enum CloudSpaceRole {
  OWNER
  EDITOR
  VIEWER
}

/// STANDARD = сервер читает объекты (нужно для превью/EXIF/транскода).
/// E2EE зарезервирован на будущее — модели уже не мешают его добавить.
enum CloudEncryptionMode {
  STANDARD
  E2EE
}

enum CloudUploadStatus {
  CREATED
  UPLOADING
  PAUSED
  UPLOADED
  VERIFYING
  PROCESSING
  READY
  FAILED
  CANCELLED
}

enum CloudFileStatus {
  PROCESSING
  READY
  FAILED
}

enum CloudFileKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

/// thumb/preview — картинки, poster — кадр видео, playback — web-совместимый MP4.
enum CloudVariantKind {
  THUMB
  PREVIEW
  POSTER
  PLAYBACK
}

enum CloudVariantStatus {
  PENDING
  READY
  FAILED
}

enum CloudShareTargetType {
  SPACE
  FOLDER
  FILE
  SELECTION
}

enum CloudReactionTargetType {
  FILE
  COMMENT
}

enum CloudActivityType {
  SPACE_CREATED
  SPACE_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  FILES_UPLOADED
  FILES_DELETED
  FILES_RESTORED
  FILES_SAVED
  FOLDER_CREATED
  FOLDER_RENAMED
  FOLDER_DELETED
  COMMENT_CREATED
  SHARE_CREATED
  SHARE_REVOKED
}

model CloudSpace {
  id               String              @id @default(cuid())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  name             String
  description      String?
  ownerId          String
  encryptionMode   CloudEncryptionMode @default(STANDARD)
  /// CloudFile.id обложки (не FK — чтобы удаление файла не роняло Space)
  coverFileId      String?
  dateFrom         DateTime?
  dateTo           DateTime?
  /// Разрешены ли комментарии участникам с ролью VIEWER
  viewerCanComment Boolean             @default(true)
  deletedAt        DateTime?

  owner    User                 @relation("CloudSpaceOwner", fields: [ownerId], references: [id])
  members  CloudSpaceMember[]
  folders  CloudFolder[]
  files    CloudFile[]
  comments CloudComment[]
  invites  CloudInvite[]
  activity CloudActivityEvent[]
  shares   CloudShareLink[]

  @@index([ownerId, deletedAt])
  @@index([deletedAt, createdAt])
}

model CloudSpaceMember {
  id          String         @id @default(cuid())
  spaceId     String
  userId      String
  role        CloudSpaceRole @default(VIEWER)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  invitedById String?
  lastSeenAt  DateTime?

  space CloudSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId, role])
}

model CloudFolder {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  spaceId     String
  parentId    String?
  name        String
  createdById String
  deletedAt   DateTime?

  space    CloudSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   CloudFolder?  @relation("CloudFolderTree", fields: [parentId], references: [id])
  children CloudFolder[] @relation("CloudFolderTree")
  files    CloudFile[]

  @@index([spaceId, parentId, deletedAt])
  @@index([spaceId, deletedAt])
  @@index([parentId])
}

/// Физический blob. Один на N логических CloudFile (дедуп/copy-on-write).
model CloudStorageObject {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())
  /// hex sha256 оригинала, считается ТОЛЬКО сервером после полной загрузки
  sha256       String      @unique
  size         BigInt
  /// путь относительно CLOUD_STORAGE_ROOT/objects, напр. "ab/cd/<id>"
  storagePath  String
  /// определённый сервером mime (file/ffprobe/magic), не то что прислал клиент
  detectedMime String?
  refCount     Int         @default(0)
  files        CloudFile[]

  @@index([refCount])
  @@index([createdAt])
}

model CloudFile {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  spaceId         String
  folderId        String?
  storageObjectId String
  originalName    String
  mimeType        String
  size            BigInt
  kind            CloudFileKind   @default(OTHER)
  uploaderId      String
  status          CloudFileStatus @default(PROCESSING)
  processingError String?

  width          Int?
  height         Int?
  /// EXIF Orientation (1..8)
  orientation    Int?
  /// Поворот, заданный пользователем: 0/90/180/270 по часовой. Оригинал
  /// неприкосновенен (контент-адресуемое хранилище) — угол хранится здесь,
  /// а превью перегенерируются уже повёрнутыми.
  rotation      Int       @default(0)
  durationMs     Int?
  /// Дата съёмки: EXIF DateTimeOriginal → mtime клиента → время загрузки
  takenAt        DateTime
  /// Откуда взялась takenAt: exif | client | upload
  takenAtSource  String    @default("upload")
  latitude       Float?
  longitude      Float?
  cameraMake     String?
  cameraModel    String?
  videoCodec     String?
  audioCodec     String?
  bitrate        Int?
  /// Оригинал можно отдавать браузеру напрямую (h264+aac, moov в начале)
  directPlayable Boolean   @default(false)
  metadata       Json?
  deletedAt      DateTime?
  deletedById    String?
  /// Помечен на безвозвратное удаление. Отличается от deletedAt (корзина):
  /// такой файл не показывается нигде, не восстанавливается и ждёт только
  /// физической уборки. Без него «удалить навсегда» ставило deletedAt в 1970,
  /// и файл спокойно возвращался кнопкой «Восстановить» из корзины.
  purgedAt       DateTime?

  /// Обратное геокодирование EXIF-координат, офлайн по датасету GeoNames.
  /// Район заполняется ТОЛЬКО когда ближайший населённый пункт честно ближе
  /// города: у GeoNames нет городских районов, и без этого условия на весь
  /// центр вешался случайный пригород.
  geoCountryCode String?
  geoCountry     String?
  geoCity        String?
  geoDistrict    String?
  /// «Страна\u0001Город\u0001Район» — один сортируемый ключ. Нужен, чтобы
  /// группы мест шли подряд и работала та же двухполевая курсорная пагинация,
  /// что и у остальных выборок.
  geoPath        String?
  geoResolvedAt  DateTime?

  space         CloudSpace         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder        CloudFolder?       @relation(fields: [folderId], references: [id])
  storageObject CloudStorageObject @relation(fields: [storageObjectId], references: [id])
  uploader      User               @relation("CloudFileUploader", fields: [uploaderId], references: [id])
  variants      CloudFileVariant[]
  comments      CloudComment[]

  @@index([purgedAt])
  @@index([spaceId, deletedAt, takenAt])
  @@index([spaceId, folderId, deletedAt, originalName])
  @@index([spaceId, deletedAt, createdAt])
  @@index([spaceId, kind, deletedAt])
  @@index([spaceId, deletedAt, geoPath])
  @@index([uploaderId, createdAt])
  @@index([storageObjectId])
  @@index([deletedAt])
}

model CloudFileVariant {
  id          String             @id @default(cuid())
  createdAt   DateTime           @default(now())
  fileId      String
  kind        CloudVariantKind
  status      CloudVariantStatus @default(PENDING)
  /// путь относительно CLOUD_STORAGE_ROOT/derived
  storagePath String?
  mimeType    String?
  size        BigInt?
  width       Int?
  height      Int?
  error       String?
  /// Какой пользовательский поворот запечён в этот вариант. По расхождению
  /// с CloudFile.rotation клиент понимает, что превью ещё старое, и до
  /// перегенерации доворачивает картинку CSS-ом.
  rotation    Int                @default(0)

  file CloudFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind])
  @@index([kind, status])
}

model CloudUploadSession {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           String
  spaceId          String
  folderId         String?
  originalName     String
  expectedSize     BigInt
  mimeType         String?
  /// Клиентский отпечаток (size|lastModified|hash头/хвоста) — для докачки на другом устройстве
  fingerprint      String
  /// id аплоада в tus-хранилище
  uploadProtocolId String            @unique
  bytesReceived    BigInt            @default(0)
  status           CloudUploadStatus @default(CREATED)
  clientMtime      DateTime?
  error            String?
  fileId           String?
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([spaceId, status])
  @@index([expiresAt])
  @@index([userId, fingerprint])
}

model CloudShareLink {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  spaceId       String
  targetType    CloudShareTargetType
  /// id файла/папки/space; для SELECTION — null (список в fileIds)
  targetId      String?
  fileIds       String[]             @default([])
  /// sha256(secret) в hex. Сам секрет живёт только во фрагменте URL у владельца.
  tokenHash     String               @unique
  /// Публичный id, который виден в URL (/cloud/s/<publicId>#t=<secret>)
  publicId      String               @unique
  allowPreview  Boolean              @default(true)
  allowDownload Boolean              @default(true)
  /// Отдавать ли получателю ссылки EXIF: координаты съёмки, модель камеры,
  /// параметры кадра. По умолчанию НЕТ — публичная ссылка на пару фотографий
  /// не должна попутно выдавать домашний адрес по геометке.
  allowMetadata Boolean              @default(false)
  passwordHash  String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String
  viewCount     Int                  @default(0)
  downloadCount Int                  @default(0)
  label         String?

  space     CloudSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation("CloudShareCreator", fields: [createdById], references: [id])

  @@index([spaceId, revokedAt])
  @@index([createdById])
}

model CloudInvite {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  spaceId     String
  tokenHash   String         @unique
  publicId    String         @unique
  role        CloudSpaceRole @default(EDITOR)
  maxUses     Int            @default(1)
  useCount    Int            @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  note        String?

  space     CloudSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation("CloudInviteCreator", fields: [createdById], references: [id])

  @@index([spaceId, revokedAt])
}

model CloudComment {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  spaceId          String
  fileId           String?
  authorId         String
  parentCommentId  String?
  /// Только plain text. Рендер на клиенте без raw HTML.
  body             String    @db.Text
  videoTimestampMs Int?
  editedAt         DateTime?
  deletedAt        DateTime?

  space   CloudSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  file    CloudFile?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author  User           @relation("CloudCommentAuthor", fields: [authorId], references: [id])
  parent  CloudComment?  @relation("CloudCommentThread", fields: [parentCommentId], references: [id])
  replies CloudComment[] @relation("CloudCommentThread")

  @@index([spaceId, createdAt])
  @@index([fileId, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
}

model CloudReaction {
  id         String                  @id @default(cuid())
  createdAt  DateTime                @default(now())
  targetType CloudReactionTargetType
  targetId   String
  userId     String
  emoji      String
  /// денормализация для ACL/выборок без join
  spaceId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
  @@index([spaceId])
}

model CloudActivityEvent {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  spaceId   String
  actorId   String
  type      CloudActivityType
  /// Агрегированные данные: {count, names[], fileId, folderName, ...}
  payload   Json?

  space CloudSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor User       @relation("CloudActivityActor", fields: [actorId], references: [id])

  @@index([spaceId, createdAt])
  @@index([actorId, createdAt])
}

/// Значимые действия отдельно от debug-логов. Без токенов и секретов.
model CloudAuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String?
  action    String
  spaceId   String?
  targetId  String?
  ip        String?
  detail    Json?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([spaceId, createdAt])
  @@index([action, createdAt])
}
